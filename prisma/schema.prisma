// This is your Prisma schema file for Creathon
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CUSTOMER
  CREATOR
  ADMIN
}

enum CreatorStatus {
  PENDING_VERIFICATION
  APPROVED
  SUSPENDED
}

enum TransactionStatus {
  PENDING
  IN_ESCROW
  COMPLETED
  CANCELLED
  REFUNDED
}

// User profile connected 1-to-1 with Supabase Auth (UUID)
model User {
  id            String         @id
  email         String         @unique
  name          String
  phone         String?
  avatarUrl     String?        @map("avatar_url")
  role          Role           @default(CUSTOMER)
  creatorStatus CreatorStatus? @map("creator_status")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  // Relasi opsional untuk Mitra / Creator
  creatorProfile CreatorProfile?

  @@map("users")
}

model Transaction {
  id                 String            @id @default(uuid())
  storeId            String
  buyerId            String
  status             TransactionStatus
  paymentChannel     String?
  grossAmount        Int
  platformFee        Int
  netAmount          Int

  // Denormalisasi: kategori & produk item utama.
  // Ini yang membuat agregasi cukup satu groupBy, tanpa join items.
  primaryCategory    String
  primaryProductId   String
  primaryProductName String

  createdAt          DateTime
  paidAt             DateTime?
  completedAt        DateTime?
  refundedAt         DateTime?

  @@index([storeId, status, createdAt])
  @@index([storeId, primaryCategory, createdAt])
}

model InsightSnapshot {
  id          String   @id @default(cuid())
  storeId     String
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date
  payload     Json
  narration   String?
  source      String   @default("template") // template | llm
  createdAt   DateTime @default(now())

  @@unique([storeId, periodStart, periodEnd])
}

model CreatorProfile {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  storeName   String   @map("store_name")
  description String?
  city        String?
  address     String?
  bannerUrl   String?  @map("banner_url")
  isVerified  Boolean  @default(false) @map("is_verified")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  products Product[]

  @@map("creator_profiles")
}

model Product {
  id             String   @id @default(uuid())
  creatorId      String   @map("creator_id")
  title          String   // Nama Produk Gift / Kriya
  slug           String   @unique
  description    String   @db.Text
  price          Int      // Harga Produk Gift (IDR)
  stock          Int      @default(1)
  category       String   // Floral, Hampers, Custom Art, Souvenir, Kriya, Accessories
  sku            String?  @unique
  images         String[] // Array URL foto produk
  isCustomizable Boolean  @default(false) @map("is_customizable")
  weightGrams    Int?     @default(500) @map("weight_grams")
  isPublished    Boolean  @default(true) @map("is_published")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  creatorProfile CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@map("products")
}
